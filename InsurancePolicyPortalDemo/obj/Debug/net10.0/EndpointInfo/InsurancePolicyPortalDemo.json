  "components": {
    "schemas": {
      "InsurancePolicy": {
        "type": "object",
        "properties": {
          "policyNumber": {
            "type": "string",
            "nullable": true
          },
          "policyHolderName": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "nullable": true
          },
          "policyType": {
            "type": "string",
            "nullable": true
          },
          "premiumAmount": {
            "type": "number",
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "nullable": true
          },
          "expiryDate": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "nomineeName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PolicyLoginRequest": {
        "required": [
          "dateOfBirth",
          "policyNumber"
        ],
        "type": "object",
        "properties": {
          "policyNumber": {
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PolicyLoginResponse": {
        "type": "object",
        "properties": {
          "isAuthenticated": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "policy": {
            "$ref": "#/components/schemas/PolicySummaryDto"
          }
        },
        "additionalProperties": false
      },
      "PolicySummaryDto": {
        "type": "object",
        "properties": {
          "policyNumber": {
            "type": "string",
            "nullable": true
          },
          "policyHolderName": {
            "type": "string",
            "nullable": true
          },
          "policyType": {
            "type": "string",
            "nullable": true
          },
          "premiumAmount": {
            "type": "number",
            "format": "double"
          },
          "startDate": {
            "type": "string",
            "nullable": true
          },
          "expiryDate": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserLoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserRegisterRequest": {
        "required": [
          "email",
          "fullName",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
